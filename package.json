{
  "name": "picshow",
  "version": "0.1.3",
  "private": true,
  "description": "PicShow —— 沉浸式跨平台照片查看器",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "icons": "python3 tools/make_icons.py",
    "test": "node tools/test_geometry.mjs",
    "test:syntax": "node tools/check_syntax.mjs",
    "test:methods": "node tools/check_methods.mjs",
    "test:tokens": "node tools/check_tokens.mjs",
    "test:boot": "node tools/check_boot.mjs",
    "test:entry": "node tools/check_preview_entry.mjs",
    "test:trackpad": "node tools/check_trackpad.mjs",
    "test:wheel": "node tools/check_wheel_swipe.mjs",
    "test:exit": "node tools/check_exit.mjs",
    "test:split": "node tools/check_window_split.mjs",
    "test:unload": "node tools/check_unload.mjs",
    "rust:check": "cd src-tauri && cargo check",
    "rust:test": "cd src-tauri && cargo test",
    "check": "npm run test:syntax && npm run rust:check && npm test && npm run test:methods && npm run test:tokens && npm run test:boot && npm run test:entry && npm run test:unload && npm run test:split && npm run test:trackpad && npm run test:wheel",
    "check:all": "npm run check && npm run test:exit && npm run probe",
    "probe": "node tools/probe_gallery.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
