{
  "name": "picshow",
  "version": "0.1.2",
  "private": true,
  "description": "PicShow —— Tauri 2 沉浸式跨平台照片查看器",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "icons": "python3 tools/make_icons.py",
    "test": "node tools/test_geometry.mjs",
    "test:methods": "node tools/check_methods.mjs",
    "test:tokens": "node tools/check_tokens.mjs",
    "test:boot": "node tools/check_boot.mjs",
    "test:trackpad": "node tools/check_trackpad.mjs",
    "test:wheel": "node tools/check_wheel_swipe.mjs",
    "rust:check": "cd src-tauri && cargo check",
    "rust:test": "cd src-tauri && cargo test",
    "check": "npm run rust:check && npm test && npm run test:methods && npm run test:tokens && npm run test:boot && npm run test:trackpad && npm run test:wheel",
    "probe": "node tools/probe_gallery.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
