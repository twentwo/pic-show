{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicShow",
  "version": "0.1.0",
  "identifier": "com.picshow.app",
  "build": {
    "beforeDevCommand": "node tools/serve.js",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PicShow",
        "width": 1200,
        "height": 800,
        "minWidth": 460,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#000000",
        "dragDropEnabled": true,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' img: asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "",
    "category": "Photography",
    "shortDescription": "沉浸式照片查看器",
    "longDescription": "PicShow 是一个轻量、跨平台的桌面照片查看器，复刻早期 Google Picasso 的流畅缩放、连续性转场与沉浸式交互体验。",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
